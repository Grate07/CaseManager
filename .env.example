# ============================================================
# Discord
# ============================================================

DISCORD_TOKEN=YOUR_DISCORD_BOT_TOKEN
DISCORD_CLIENT_ID=YOUR_DISCORD_APPLICATION_ID
DISCORD_GUILD_ID=YOUR_DISCORD_SERVER_ID


# ============================================================
# Supabase PostgreSQL
# ============================================================

DATABASE_HOST=YOUR_POOLER_HOST
DATABASE_PORT=5432
DATABASE_NAME=postgres
DATABASE_USER=postgres.YOUR_PROJECT_REF
DATABASE_PASSWORD=YOUR_DATABASE_PASSWORD
DATABASE_SSL=true
DATABASE_POOL_SIZE=5


# ============================================================
# CaseManager Discord Permissions
# ============================================================

# Available:
#
# global
# per-command
#
CASEMANAGER_PERMISSION_MODE=global


# ============================================================
# OPTION 1 — ONE ROLE FOR EVERYTHING
# ============================================================

# Paste the Discord ROLE ID here.
#
# Every CaseManager command will require
# this role when permission mode is "global".
#
CASEMANAGER_ROLE_ID=


# ============================================================
# OPTION 2 — DIFFERENT ROLE PER COMMAND
# ============================================================

CASEMANAGER_ROLE_CASE=
CASEMANAGER_ROLE_EVIDENCE=
CASEMANAGER_ROLE_TIMELINE=
CASEMANAGER_ROLE_INVESTIGATORS=
CASEMANAGER_ROLE_STATUS=
CASEMANAGER_ROLE_SETTINGS=
CASEMANAGER_ROLE_PERMISSIONS


# ============================================================
# Debug
# ============================================================

BOT_DEBUG=false